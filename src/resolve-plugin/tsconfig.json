{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@xdrop/shared-types": ["src/shared/types.ts"],
      "@xdrop/protocol": ["src/shared/protocol.ts"],
      "@xdrop/utilities": ["src/shared/utilities.ts"],
      "@resolvefetch/shared-types": ["src/shared/types.ts"],
      "@resolvefetch/protocol": ["src/shared/protocol.ts"],
      "@resolvefetch/utilities": ["src/shared/utilities.ts"]
    }
  },
  "include": ["src"]
}
