<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="7.0" ExtensionBundleId="com.xdrop.panel" ExtensionBundleVersion="1.0.0"
    ExtensionBundleName="Xdrop" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <ExtensionList>
        <Extension Id="com.xdrop.panel" Version="1.0.0" />
    </ExtensionList>
    <ExecutionEnvironment>
        <HostList>
            <!-- PPRO = Adobe Premiere Pro -->
            <Host Name="PPRO" Version="[14.0,99.9]" />
            <!-- AEFT = Adobe After Effects -->
            <Host Name="AEFT" Version="[14.0,99.9]" />
        </HostList>
        <LocaleList>
            <Locale Code="All" />
        </LocaleList>
        <RequiredRuntimeList>
            <RequiredRuntime Name="CSXS" Version="9.0" />
        </RequiredRuntimeList>
    </ExecutionEnvironment>
    <DispatchInfoList>
        <Extension Id="com.xdrop.panel">
            <DispatchInfo>
                <Resources>
                    <MainPath>./index.html</MainPath>
                    <ScriptPath>./jsx/hostscript.jsx</ScriptPath>
                    <CEPEngine>
                        <CommandLine>
                            <Parameter>--enable-nodejs</Parameter>
                            <Parameter>--mixed-context</Parameter>
                        </CommandLine>
                    </CEPEngine>
                </Resources>
                <Lifecycle>
                    <AutoVisible>true</AutoVisible>
                </Lifecycle>
                <UI>
                    <Type>Panel</Type>
                    <Menu>Xdrop</Menu>
                    <Geometry>
                        <Size>
                            <Height>650</Height>
                            <Width>440</Width>
                        </Size>
                        <MinSize>
                            <Height>400</Height>
                            <Width>340</Width>
                        </MinSize>
                    </Geometry>
                    <Icons />
                </UI>
            </DispatchInfo>
        </Extension>
    </DispatchInfoList>
</ExtensionManifest>
